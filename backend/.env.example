# ---------------------------------------------------------------------------
# PromptLens backend configuration
# Copy this file to .env and fill in values as needed.
# ---------------------------------------------------------------------------

# Optional: Hugging Face Inference Providers token. If left empty, the backend
# automatically falls back to the built-in deterministic heuristic analyzer —
# the app works fully without this, just with lower-quality analysis.
HF_API_TOKEN=
GROQ_API_KEY=
# Hugging Face model id used for analysis when HF_API_TOKEN is set.
HF_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct

# Comma-separated list of allowed CORS origins for the frontend.
# For local dev with the default CRA dev server:
CORS_ORIGINS=prompt-lens-93klu9z59-pranjaldubs-projects.vercel.app

# Port the server listens on (used by uvicorn locally; Render sets $PORT itself).
PORT=8000
